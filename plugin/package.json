{
  "name": "dsh-pocket-ios",
  "version": "0.7.1",
  "description": "给 DSH 设置页加「手机访问（iOS）」：局域网 / Cloudflare / Tailscale / EasyTier 四种连接方式可切换，扫码即连；附带 CLI 供无图形界面的服务器在终端出二维码",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "bin",
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale",
    "icon.png"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ios",
    "mobile",
    "pocket",
    "tailscale",
    "cloudflare-tunnel",
    "easytier",
    "wireguard"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jqlong17/dsh-pocket-ios.git",
    "directory": "plugin"
  },
  "homepage": "https://dsh-pocket.docs.notta.uk",
  "bugs": {
    "url": "https://github.com/jqlong17/dsh-pocket-ios/issues"
  },
  "author": "Ruska <jqlong17@gmail.com>",
  "bin": {
    "dsh-pocket-ios": "bin/dsh-pocket-ios.js"
  }
}
